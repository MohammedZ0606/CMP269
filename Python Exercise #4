def task_3_data_manipulation():

    import pandas as pd

    allData = {
        "CourseCode": ["CMP168", "CMP269", "CMP338"],
        "Credits": [4, 4, 4],
        "Enrolled": [25, 30, 20]
    }

    dataFrame = pd.DataFrame(allData)
    print(dataFrame)
    
    filteredData = dataFrame[dataFrame["Enrolled"] > 20]
    
    print("Filtered Courses (>20 students):")
    
    print(filteredData)
    
    totalStudents = dataFrame["Enrolled"].sum()
    
    print("\nTotal Students:", totalStudents)

