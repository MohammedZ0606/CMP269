1: QR Code Generator for email

import com.google.zxing.BarcodeFormat
import com.google.zxing.qrcode.QRCodeWriter
import com.google.zxing.client.j2se.MatrixToImageWriter
import java.nio.file.FileSystems

fun saveQRCode(content: String, fileName: String) {
    val qrCode = QRCodeWriter()
    val matrix = qrCode.encode(content, BarcodeFormat.QR_CODE, 400, 400)
    val codePath = FileSystems.getDefault().getPath(fileName)

    MatrixToImageWriter.writeToPath(matrix, "PNG", codePath)
}

fun main() {
    val email = "mohammed.zaman1@lc.cuny.edu"

    saveQRCode(email, "my_email.png")
    println("The QR code has been saved as email")
}

