def task_3_api_status_checker():

    import requests

    myURL = "https://jsonplaceholder.typicode.com/posts/101"

    try:
        res = requests.get(myURL, timeout = 10)

        if res.status_code == 200:
            print(res.json()) #prints the data
        elif res.status_code == 404:
            print("Error: Post not found.") #error
        else:
            print(f"Error: Received status code {res.status_code}")

    except requests.exceptions.Timeout:
        print("Request timed out.")
    except requests.exceptions.RequestException as e:
        print(f"Error: {e}")

