def task_5_integration_report():

    import requests

    myURL = "https://jsonplaceholder.typicode.com/posts/1"

    try:
        res = requests.get(myURL, timeout = 10)
        res.raise_for_status()

        myData = res.json()

        title = myData.get("title", "")
        body = myData.get("body", "")

        with open("api_report.txt", "w") as file:
            file.write("API REPORT\n")
            file.write("===========\n\n")
            file.write(f"Title: {title}\n\n")
            file.write(f"Body:\n{body}\n")
            
    except requests.exceptions.Timeout:
        print("Request timed out.")
    except requests.exceptions.RequestException as e:
        print(f"Error: {e}")

